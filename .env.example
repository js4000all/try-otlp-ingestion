# Collector profile: local.yaml, grafana-cloud.yaml, or mackerel.yaml
OTEL_COLLECTOR_CONFIG=local.yaml

# Local VictoriaMetrics (optional; Compose provides a default)
# VM_OTLP_METRICS_ENDPOINT=http://victoriametrics:8428/opentelemetry/v1/metrics

# Grafana Cloud Collector setup credentials (required for grafana-cloud.yaml)
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=

# Mackerel labeled metrics (required for mackerel.yaml; Write permission)
MACKEREL_APIKEY=
